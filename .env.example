# --- AI (Brain) ---
# Groq (recommended here: fast + free tier). Create a key at console.groq.com
GROQ_API_KEY=gsk_...
# Optional: override the Groq model (default: llama-3.3-70b-versatile)
# GROQ_MODEL=llama-3.3-70b-versatile
# GROQ_BASE_URL=https://api.groq.com/openai/v1

# OpenAI (used only if GROQ_API_KEY is not set)
OPENAI_API_KEY=
# Any OpenAI-compatible endpoint (e.g. OpenRouter, vLLM, LM Studio)
OPENAI_BASE_URL=
# Applies to whichever provider is active
AI_MODEL=

# --- Bridge (Hands) ---
# Local dev: daemon on your PC at http://localhost:8765
# You can also set this per-browser in the app (Connect my PC card)
BRIDGE_URL=http://localhost:8765
BRIDGE_TOKEN=change-me-to-a-long-random-secret

# --- Cloud audit trail (Supabase) ---
# Without these the trail is per-instance memory and vanishes on redeploy.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_AUDIT_TABLE=whitty_audit

# --- Bridge host allowlist ---
# Named tunnels on your own domain must be listed here (comma-separated hosts).
# *.trycloudflare.com, *.ngrok-free.app, *.ts.net and localhost are allowed by default.
# BRIDGE_ALLOWED_HOSTS=witty.mydomain.com

# --- VPN ---
VPN_SERVER_ENDPOINT=your-vps-or-pc-public-ip:51820
VPN_DNS=1.1.1.1
