# --- AI (Brain) ---
OPENAI_API_KEY=sk-...
# Optional: use any OpenAI-compatible endpoint
OPENAI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini

# --- Bridge (Hands) ---
# Local dev: daemon on your PC at http://localhost:8765
# Production: your Cloudflare Tunnel URL, e.g. https://bridge.yourdomain.com
BRIDGE_URL=http://localhost:8765
BRIDGE_TOKEN=change-me-to-a-long-random-secret

# --- VPN ---
VPN_SERVER_ENDPOINT=your-vps-or-pc-public-ip:51820
VPN_DNS=1.1.1.1
